<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}Películas{% endblock %}</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 960px; margin: 30px auto; padding: 0 20px; }
    nav { display: flex; gap: 20px; margin-bottom: 30px; }
    table { width: 100%; border-collapse: collapse; }
    th, td { border: 1px solid #ccc; padding: 10px; text-align: left; }
    label { display: block; margin-top: 15px; }
    input { padding: 6px; max-width: 100%; box-sizing: border-box; }
    .movie-form input { display: block; width: 400px; margin-top: 5px; }
    button { padding: 6px 12px; cursor: pointer; }
    .actions { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
    .movie-form button { margin-top: 20px; }
  </style>
</head>
<body>
  <nav>
    <a href="/web/movies">Listado de películas</a>
    <a href="/web/movies/new">Añadir película</a>
  </nav>
  <main>
    {% block content %}{% endblock %}
  </main>
</body>
</html>
